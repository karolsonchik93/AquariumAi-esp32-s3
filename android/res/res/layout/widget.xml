<?xml version="1.0" encoding="utf-8"?>
<!-- Только классы, разрешённые в RemoteViews: LinearLayout, TextView, ProgressBar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Аквариум"
            android:textColor="#7DD3FC"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/wStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="норма"
            android:textColor="#22D37F"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/wTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#E8EEF6"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/wUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="°C"
            android:textColor="#8B9BAD"
            android:textSize="12sp"
            android:layout_marginStart="3dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wSp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="цель 25.0 °C"
        android:textColor="#8B9BAD"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/wHeat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="нагрев выкл"
        android:textColor="#8B9BAD"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/wLightBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/wLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="свет 0%"
        android:textColor="#8B9BAD"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wFeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/feed_idle"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="КОРМ"
            android:textColor="#E9F94B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/wRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="2dp"
            android:text="⟳"
            android:textColor="#22D3EE"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wFoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="—"
        android:textColor="#4D5B6B"
        android:textSize="10sp" />
</LinearLayout>
